{
  "name": "reporting-rollup-job",
  "version": "0.1.0",
  "private": true,
  "description": "Materialization job: folds per-order facts into day-partitioned rollup cubes; backfills and reconciles. Runs on a cron schedule.",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "sync:shared": "node scripts/sync-shared.mjs --with-node",
    "prebuild": "npm run sync:shared",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "predev": "npm run sync:shared",
    "dev": "tsx src/index.ts",
    "pretest": "npm run sync:shared",
    "test": "tsc --noEmit && vitest run",
    "backfill": "node dist/src/index.js"
  },
  "dependencies": {
    "@commercetools/platform-sdk": "^9.4.0",
    "@commercetools/ts-client": "^5.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "5.9.2",
    "vitest": "^3.2.5"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "vite": "^6.4.3"
  }
}
