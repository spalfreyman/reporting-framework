{
  "name": "reporting-event-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Dev tool: generates realistic test orders (and optionally GA4 events) in a commercetools project so the reports have data to render. Not a Connect app.",
  "type": "module",
  "scripts": {
    "seed": "sh with-ca.sh tsx src/generate.ts seed",
    "loop": "sh with-ca.sh tsx src/generate.ts loop",
    "cleanup": "sh with-ca.sh tsx src/generate.ts cleanup",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
