# Copy to .env for local development. .env is gitignored.
# This Merchant Center application holds NO credentials — it reaches the gateway through the
# MC /proxy/forward-to endpoint — so nothing secret belongs here.

# Required by mc-scripts for local dev:
ENABLE_NEW_JSX_TRANSFORM="true"
FAST_REFRESH="true"

# Injected by Connect in production; set for local dev:
CLOUD_IDENTIFIER=gcp-eu
ENTRY_POINT_URI_PATH=reporting
INITIAL_PROJECT_KEY=your-project-key
CUSTOM_APPLICATION_ID=local-development
APPLICATION_URL=http://localhost:3001

# Optional override; normally the gateway publishes its own URL. Set for local dev:
REPORTING_GATEWAY_URL=http://localhost:8080
