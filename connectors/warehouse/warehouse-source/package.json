{
  "name": "warehouse-source",
  "version": "0.1.0",
  "private": true,
  "description": "Data warehouse reporting source. Whitelisted parameterised SQL (Postgres) plus a deterministic demo mode. The scale tier for SKU/customer-grain, cost and spend.",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "sync:shared": "node scripts/sync-shared.mjs --with-node",
    "prebuild": "npm run sync:shared",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "predev": "npm run sync:shared",
    "dev": "tsx watch src/index.ts",
    "pretest": "npm run sync:shared",
    "test": "tsc --noEmit && node --import tsx --test \"tests/*.test.ts\"",
    "connector:post-deploy": "node dist/connector/post-deploy.js",
    "connector:pre-undeploy": "node dist/connector/pre-undeploy.js"
  },
  "dependencies": {
    "@commercetools/platform-sdk": "^9.4.0",
    "@commercetools/ts-client": "^5.0.2",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
