{
  "name": "erp-oms-source",
  "version": "0.1.0",
  "private": true,
  "description": "ERP/OMS reporting source. Config-driven REST client with a built-in fake ERP for demo. Stock cover, fill rate, fulfilment SLA, returns.",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "sync:shared": "node scripts/sync-shared.mjs --with-node",
    "prebuild": "npm run sync:shared",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "predev": "npm run sync:shared",
    "dev": "tsx watch src/index.ts",
    "pretest": "npm run sync:shared",
    "test": "tsc --noEmit && vitest run",
    "connector:post-deploy": "node dist/connector/post-deploy.js",
    "connector:pre-undeploy": "node dist/connector/pre-undeploy.js"
  },
  "dependencies": {
    "@commercetools/platform-sdk": "^9.4.0",
    "@commercetools/ts-client": "^5.0.2",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "5.9.2",
    "vitest": "^3.2.5"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "vite": "^6.4.3"
  }
}
