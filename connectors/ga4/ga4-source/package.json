{
  "name": "ga4-source",
  "version": "0.1.0",
  "private": true,
  "description": "Google Analytics 4 reporting data source. Live GA4 Data API with a per-property quota cache, plus a deterministic demo mode.",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "sync:shared": "node scripts/sync-shared.mjs --with-node",
    "prebuild": "npm run sync:shared",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "predev": "npm run sync:shared",
    "dev": "tsx watch src/index.ts",
    "pretest": "npm run sync:shared",
    "test": "tsc --noEmit && node --import tsx --test \"tests/*.test.ts\"",
    "connector:post-deploy": "node dist/connector/post-deploy.js",
    "connector:pre-undeploy": "node dist/connector/pre-undeploy.js"
  },
  "dependencies": {
    "@commercetools/platform-sdk": "^9.4.0",
    "@commercetools/ts-client": "^5.0.2",
    "@google-analytics/data": "^5.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
