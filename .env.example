# Contract for local development. Copy per app and fill in.
# Real values are injected by Connect in production.

CTP_PROJECT_KEY=your-project-key
CTP_REGION=europe-west1.gcp
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_SCOPE=manage_project:your-project-key
CLOUD_IDENTIFIER=gcp-eu

# Gateway <-> connector shared bearer secret. Must be IDENTICAL on both. >= 16 chars.
REPORTING_SHARED_SECRET=
