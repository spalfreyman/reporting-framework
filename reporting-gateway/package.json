{
  "name": "reporting-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Query gateway: verifies the Merchant Center session, resolves the access frame, plans, fans out to data sources, merges and caches.",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "presync:shared": "echo syncing shared contracts",
    "sync:shared": "node scripts/sync-shared.mjs",
    "prebuild": "npm run sync:shared",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "predev": "npm run sync:shared",
    "dev": "tsx watch src/index.ts",
    "pretest": "npm run sync:shared",
    "test": "tsc --noEmit && node --import tsx --test \"tests/*.test.ts\"",
    "connector:post-deploy": "node dist/connector/post-deploy.js",
    "connector:pre-undeploy": "node dist/connector/pre-undeploy.js"
  },
  "dependencies": {
    "@commercetools/platform-sdk": "^9.4.0",
    "@commercetools/ts-client": "^5.0.2",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.0",
    "jose": "^5.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
